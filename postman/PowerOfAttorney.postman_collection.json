{
  "info": {
    "name": "Rabobank Power of Attorney API",
    "description": "Postman collection for the Power of Attorney Management API. Endpoints align with AccountController and AuditController under api/src/main/java/nl/rabobank/controller.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Create Power of Attorney",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/authorization",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "authorization"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grantorName\": \"{{grantorName}}\",\n  \"granteeName\": \"{{granteeName}}\",\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"authorization\": \"{{authorization}}\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get Power of Attorney by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/authorization/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "authorization",
            "{{id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Authorization",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/authorization/{{id}}?newAuthorization={{newAuthorization}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "authorization",
            "{{id}}"
          ],
          "query": [
            {
              "key": "newAuthorization",
              "value": "{{newAuthorization}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Accounts Accessible by Grantee",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/accessible-by/{{granteeName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "accessible-by",
            "{{granteeName}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Power of Attorney by Grantor",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/authorization/granted-by/{{grantorName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "authorization",
            "granted-by",
            "{{grantorName}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Power of Attorney",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/v1/account/authorization/{{id}}?grantorName={{grantorName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "account",
            "authorization",
            "{{id}}"
          ],
          "query": [
            {
              "key": "grantorName",
              "value": "{{grantorName}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Audit Logs by Actor",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/audits/actor/{{actorName}}?page={{page}}&size={{size}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "audits",
            "actor",
            "{{actorName}}"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{page}}"
            },
            {
              "key": "size",
              "value": "{{size}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Audit Logs by Account",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/audits/account/{{accountNumber}}?page={{page}}&size={{size}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "audits",
            "account",
            "{{accountNumber}}"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{page}}"
            },
            {
              "key": "size",
              "value": "{{size}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "id",
      "value": "POA-EXAMPLE-ID"
    },
    {
      "key": "grantorName",
      "value": "Cheddar"
    },
    {
      "key": "granteeName",
      "value": "Merkur"
    },
    {
      "key": "accountNumber",
      "value": "ACC0001"
    },
    {
      "key": "authorization",
      "value": "READ"
    },
    {
      "key": "newAuthorization",
      "value": "READ"
    },
    {
      "key": "actorName",
      "value": "Cheddar"
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "5"
    }
  ]
}